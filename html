    const totalQuestions = questions.length;
    let currentIndex = 0;
    // responses: object { q1: 1..6, q2: ... }
    let responses = {};

    // DOM refs
    const qNumberEl = document.getElementById('qNumber');
    const qSectionEl = document.getElementById('qSection');
    const qTextEl = document.getElementById('qText');
    const optionsContainer = document.getElementById('optionsContainer');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const resetBtn = document.getElementById('resetBtn');
    const questionArea = document.getElementById('questionArea');
    const resultsArea = document.getElementById('resultsArea');
    const resultsContainer = document.getElementById('resultsContainer');
    const totalScoreEl = document.getElementById('totalScore');
    const backToQuestionsBtn = document.getElementById('backToQuestionsBtn');
    const resetResultsBtn = document.getElementById('resetResultsBtn');

    // ---------- helper functions ----------
    function loadFromStorage() {
      const stored = localStorage.getItem('cbcResponses');
      if (stored) {
        try {
          responses = JSON.parse(stored);
          // ensure all question ids exist, default to undefined
          questions.forEach(q => {
            if (!(q.id in responses)) {
              responses[q.id] = undefined;
            }
          });
        } catch (e) {
          responses = {};
        }
      } else {
        // initialize
        questions.forEach(q => { responses[q.id] = undefined; });
      }
    }

    function saveToStorage() {
      localStorage.setItem('cbcResponses', JSON.stringify(responses));
    }

    function getCurrentQuestion() {
      return questions[currentIndex];
    }

    function renderQuestion() {
      const q = getCurrentQuestion();
      qNumberEl.textContent = `السؤال ${currentIndex+1}`;
      qSectionEl.textContent = `(${q.section})`;
      qTextEl.textContent = q.text;

      // generate radio options
      let html = '';
      const labels = ['كثير جداً', 'كثير', 'قليل', 'نادر', 'نادر جداً', 'لا يحدث مطلقاً'];
      for (let i = 1; i <= 6; i++) {
        const checked = (responses[q.id] === i) ? 'checked' : '';
        html += `
          <div class="option-item">
            <input type="radio" name="qOption" value="${i}" id="${q.id}_${i}" ${checked}>
            <label for="${q.id}_${i}">${i}<br><span style="font-weight:400;font-size:11px;display:block;color:#64748b;">${labels[i-1]}</span></label>
          </div>
        `;
      }
      optionsContainer.innerHTML = html;

      // attach change event to save
      const radios = optionsContainer.querySelectorAll('input[type="radio"]');
      radios.forEach(radio => {
        radio.addEventListener('change', function(e) {
          const val = parseInt(this.value, 10);
          responses[q.id] = val;
          saveToStorage();
          updateProgress();
        });
      });

      updateProgress();
      updateNavButtons();
    }

    function updateProgress() {
      const answered = questions.filter(q => responses[q.id] !== undefined && responses[q.id] !== null).length;
      const pct = (answered / totalQuestions) * 100;
      progressFill.style.width = pct + '%';
      progressText.textContent = `${answered} / ${totalQuestions}`;
    }

    function updateNavButtons() {
      prevBtn.disabled = (currentIndex === 0);
      if (currentIndex === totalQuestions - 1) {
        nextBtn.textContent = '🏁 إنهاء';
        nextBtn.classList.add('btn-success');
        nextBtn.classList.remove('btn-primary');
      } else {
        nextBtn.textContent = 'التالي ⟫';
        nextBtn.classList.remove('btn-success');
        nextBtn.classList.add('btn-primary');
      }
    }

    function goToPrev() {
      if (currentIndex > 0) {
        currentIndex--;
        renderQuestion();
      }
    }

    function goToNext() {
      // save current value if any (already saved via change)
      // if last question, show results
      if (currentIndex === totalQuestions - 1) {
        showResults();
        return;
      }
      if (currentIndex < totalQuestions - 1) {
        currentIndex++;
        renderQuestion();
      }
    }

    // ---------- Results ----------
    function showResults() {
      // check if all answered? we can show anyway
      questionArea.style.display = 'none';
      resultsArea.classList.add('active');
      renderResults();
    }

    function renderResults() {
      const sections = ['شخصي', 'أسري', 'اجتماعي', 'مدرسي', 'جسمي'];
      const sectionMap = {};
      sections.forEach(s => { sectionMap[s] = { sum: 0, count: 0, items: [] }; });

      questions.forEach(q => {
        const val = responses[q.id];
        if (val !== undefined && val !== null) {
          const sec = q.section;
          if (sectionMap[sec]) {
            sectionMap[sec].sum += val;
            sectionMap[sec].count++;
            sectionMap[sec].items.push(val);
          }
        }
      });

      let html = '';
      let grandTotal = 0;
      let grandCount = 0;

      sections.forEach(sec => {
        const data = sectionMap[sec];
        const avg = data.count > 0 ? (data.sum / data.count) : 0;
        const avgRounded = avg.toFixed(2);
        grandTotal += data.sum;
        grandCount += data.count;

        // bar percentage: since 1 is worst, 6 is best, we show bar as (avg / 6)*100 but we want low avg to show red.
        // We'll display avg value, and a bar from 0 to 6.
        const barPercent = (avg / 6) * 100;
        let barColor = '#22c55e'; // green (good)
        if (avg < 2.5) barColor = '#ef4444'; // red (problem)
        else if (avg < 4) barColor = '#f59e0b'; // yellow

        html += `
          <div class="result-card">
            <div>
              <div class="section-name">${sec}</div>
              <div style="font-size:13px;color:#64748b;">عدد الإجابات: ${data.count}</div>
            </div>
            <div class="avg-score" style="background:${barColor}20; color:${barColor};">
              ${avgRounded}
            </div>
            <div class="result-bar">
              <div class="bar-fill" style="width:${barPercent}%; background:${barColor};"></div>
            </div>
          </div>
        `;
      });

      resultsContainer.innerHTML = html;

      const overallAvg = grandCount > 0 ? (grandTotal / grandCount) : 0;
      totalScoreEl.textContent = `المعدل العام: ${overallAvg.toFixed(2)} من 6 (كلما قل الرقم، زادت المشكلة)`;
    }

    function hideResults() {
      resultsArea.classList.remove('active');
      questionArea.style.display = 'block';
      renderQuestion();
    }

    // ---------- Reset ----------
    function resetAll() {
      if (confirm('هل أنت متأكد من مسح جميع الإجابات؟')) {
        questions.forEach(q => { responses[q.id] = undefined; });
        saveToStorage();
        currentIndex = 0;
        if (resultsArea.classList.contains('active')) {
          hideResults();
        } else {
          renderQuestion();
        }
        updateProgress();
      }
    }

    // ---------- Init ----------
    function init() {
      loadFromStorage();
      // ensure all keys exist
      questions.forEach(q => {
        if (!(q.id in responses)) responses[q.id] = undefined;
      });
      saveToStorage();

      // if all questions answered, maybe show results? but we start with questions.
      // check if any unanswered, if all answered we can optionally show results but we keep questions.
      // We'll just start at index 0.
      currentIndex = 0;
      renderQuestion();

      // event listeners
      prevBtn.addEventListener('click', goToPrev);
      nextBtn.addEventListener('click', goToNext);
      resetBtn.addEventListener('click', resetAll);
      backToQuestionsBtn.addEventListener('click', hideResults);
      resetResultsBtn.addEventListener('click', resetAll);
    }

    init();
  })();
</script>
</body>
</html>
