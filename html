      </div>
      <div class="q-text" id="qText">نص السؤال هنا</div>
      <div class="options-grid" id="optionsContainer">
        <!-- generated by JS -->
      </div>
    </div>

    <div class="nav-buttons">
      <button class="btn btn-secondary" id="prevBtn">⟪ السابق</button>
      <button class="btn btn-primary" id="nextBtn">التالي ⟫</button>
      <button class="btn btn-danger" id="resetBtn" style="flex:0 1 auto; min-width:60px;">↺</button>
    </div>
  </div>

  <!-- Results area -->
  <div class="results-section" id="resultsArea">
    <div class="results-title">📊 نتائج التقييم</div>
    <div id="resultsContainer"></div>
    <div class="total-score" id="totalScore"></div>
    <div class="btn-group">
      <button class="btn btn-secondary" id="backToQuestionsBtn">🔙 العودة للأسئلة</button>
      <button class="btn btn-danger" id="resetResultsBtn">🗑️ إعادة تعيين</button>
    </div>
  </div>
</div>

